{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/v1/simulation-preset.schema.json",
  "title": "SimulationPreset",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "$ref": "https://contracts.example.invalid/v1/common.schema.json#/$defs/project"
    },
    "preset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "mode": {
      "const": "SANDBOX_DETERMINISTIC"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "input": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "https://contracts.example.invalid/v1/common.schema.json#/$defs/json-value"
      }
    },
    "fixtures_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "preset_id",
    "title",
    "description",
    "mode",
    "seed",
    "input",
    "fixtures_version"
  ],
  "additionalProperties": false
}
