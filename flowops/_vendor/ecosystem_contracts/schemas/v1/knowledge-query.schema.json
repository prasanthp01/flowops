{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/v1/knowledge-query.schema.json",
  "title": "KnowledgeQuery",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "application_id": {
      "$ref": "https://contracts.example.invalid/v1/common.schema.json#/$defs/project"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "collection_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
      },
      "maxItems": 8,
      "minItems": 1
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "max_excerpt_chars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "mode": {
      "enum": [
        "SANDBOX_DETERMINISTIC",
        "REPLAY_RECORDED",
        "LIVE_MODEL_AUTHENTICATED"
      ]
    }
  },
  "required": [
    "schema_version",
    "application_id",
    "tenant_id",
    "query",
    "collection_ids",
    "max_results",
    "max_excerpt_chars",
    "correlation_id",
    "mode"
  ],
  "additionalProperties": false
}
