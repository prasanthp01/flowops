{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/v1/simulation-events.schema.json",
  "title": "SimulationEvents",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.example.invalid/v1/simulation-event.schema.json"
      },
      "maxItems": 128,
      "minItems": 0
    },
    "next_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "terminal": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "events",
    "next_sequence",
    "terminal"
  ],
  "additionalProperties": false
}
