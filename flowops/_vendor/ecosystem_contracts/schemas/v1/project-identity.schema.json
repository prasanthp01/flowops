{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/v1/project-identity.schema.json",
  "title": "ProjectIdentity",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "$ref": "https://contracts.example.invalid/v1/common.schema.json#/$defs/project"
    },
    "origin": {
      "const": "https://portfolio.gappazappa.in"
    },
    "case_study_route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "api_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "app_route": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 96
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "origin",
    "case_study_route",
    "api_prefix",
    "app_route"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "project_id": {
            "const": "resolveai"
          }
        }
      },
      "then": {
        "properties": {
          "case_study_route": {
            "const": "/projects/resolveai"
          },
          "api_prefix": {
            "const": "/api/projects/resolveai"
          },
          "app_route": {
            "enum": [
              null,
              "/projects/resolveai/app/"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project_id": {
            "const": "flowops"
          }
        }
      },
      "then": {
        "properties": {
          "case_study_route": {
            "const": "/projects/flowops"
          },
          "api_prefix": {
            "const": "/api/projects/flowops"
          },
          "app_route": {
            "enum": [
              null,
              "/projects/flowops/app/"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project_id": {
            "const": "knowledgeops"
          }
        }
      },
      "then": {
        "properties": {
          "case_study_route": {
            "const": "/projects/knowledgeops"
          },
          "api_prefix": {
            "const": "/api/projects/knowledgeops"
          },
          "app_route": {
            "enum": [
              null,
              "/projects/knowledgeops/app/"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project_id": {
            "const": "agentops"
          }
        }
      },
      "then": {
        "properties": {
          "case_study_route": {
            "const": "/projects/agentops"
          },
          "api_prefix": {
            "const": "/api/projects/agentops"
          },
          "app_route": {
            "enum": [
              null,
              "/projects/agentops/app/"
            ]
          }
        }
      }
    }
  ]
}
