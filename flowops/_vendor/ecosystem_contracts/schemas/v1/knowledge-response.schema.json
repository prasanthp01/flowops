{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/v1/knowledge-response.schema.json",
  "title": "KnowledgeResponse",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "OK",
        "NO_RESULTS",
        "DENIED"
      ]
    },
    "answer": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3000
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "passage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidence": {
            "$ref": "https://contracts.example.invalid/v1/common.schema.json#/$defs/evidence"
          }
        },
        "required": [
          "source_id",
          "title",
          "passage",
          "location",
          "evidence"
        ],
        "additionalProperties": false
      },
      "maxItems": 10,
      "minItems": 0
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "mode": {
      "enum": [
        "SANDBOX_DETERMINISTIC",
        "REPLAY_RECORDED",
        "LIVE_MODEL_AUTHENTICATED"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "maxItems": 16,
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "status",
    "answer",
    "citations",
    "correlation_id",
    "mode",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "DENIED",
              "NO_RESULTS"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "type": "null"
          },
          "citations": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
