{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "SANDBOX_DETERMINISTIC",
        "REPLAY_RECORDED",
        "LIVE_MODEL_AUTHENTICATED"
      ]
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "fixtures_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "output": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "ACTUAL",
            "ESTIMATED",
            "SIMULATED",
            "NONE"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "mode",
    "status",
    "app_version",
    "output",
    "evidence",
    "errors",
    "cost"
  ],
  "additionalProperties": false
}
