{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "enum": [
        "resolveai",
        "flowops",
        "knowledgeops",
        "agentops"
      ]
    },
    "mode": {
      "enum": [
        "SANDBOX_DETERMINISTIC",
        "REPLAY_RECORDED",
        "LIVE_MODEL_AUTHENTICATED"
      ]
    },
    "preset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {
      "type": "object"
    },
    "client_correlation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "mode",
    "input"
  ],
  "additionalProperties": false
}
