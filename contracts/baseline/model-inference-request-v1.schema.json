{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "application_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "allowed_regions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "latency_deadline_ms": {
      "type": "integer",
      "minimum": 1
    },
    "max_cost": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "routing_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "SANDBOX_DETERMINISTIC",
        "REPLAY_RECORDED",
        "LIVE_MODEL_AUTHENTICATED"
      ]
    }
  },
  "required": [
    "schema_version",
    "application_id",
    "environment",
    "task_type",
    "required_capabilities",
    "data_classification",
    "allowed_regions",
    "latency_deadline_ms",
    "max_cost",
    "currency",
    "routing_policy_version",
    "correlation_id",
    "operation_id",
    "mode"
  ],
  "additionalProperties": false
}
